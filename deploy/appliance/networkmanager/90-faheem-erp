#!/bin/sh
# NetworkManager dispatcher: when the PC's network comes up or changes (e.g. moved from one Wi-Fi to
# another), let the ERP follow its new address for the shop-network HTTPS access.
case "$2" in
  up|dhcp4-change|connectivity-change)
    [ -x /opt/faheem-erp/current/bin/network.sh ] && /opt/faheem-erp/current/bin/network.sh lan refresh --yes >/dev/null 2>&1 &
    ;;
esac
exit 0
