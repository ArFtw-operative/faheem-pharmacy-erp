# Development only — NOT for an installed PC (the installer generates real secrets).
FAHEEM_IMAGE=faheem-pharmacy-erp
FAHEEM_VERSION=dev
FAHEEM_DATA=./.appliance/data
FAHEEM_LOGS=./.appliance/logs
FAHEEM_BACKUPS=./.appliance/backups
FAHEEM_UID=10001
FAHEEM_GID=10001
FAHEEM_BIND=127.0.0.1
FAHEEM_PORT=8800
POSTGRES_PASSWORD=dev-only-postgres
PHARMACY_SECRET_KEY=dev-only-secret-key-not-for-production-0000
PHARMACY_WPP_SECRET=dev-only-wpp
FAHEEM_PROXY_DIR=./deploy/appliance/proxy
