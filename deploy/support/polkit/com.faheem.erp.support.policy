<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Faheem Pharmacy ERP</vendor>
  <!-- The person at the counter turns remote support on / off without a password. faheem-support itself
       allows only enable (fixed duration), disable and status when started this way (PKEXEC_UID). -->
  <action id="com.faheem.erp.support">
    <description>Turn Faheem Remote Support on or off</description>
    <message>Faheem Remote Support</message>
    <icon_name>help-browser</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/faheem-support</annotate>
  </action>
</policyconfig>
